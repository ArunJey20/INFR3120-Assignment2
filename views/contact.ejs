

<%- include('partials/header') %>


    <div class="container mt-4">
        <h1>Contact Me</h1>
        <p>Feel free to contact me using the form below.</p>

        <form>
            <div class="mb-3">
                <label for="email" class="form-label">
                    <i class="fa-solid fa-envelope"></i> Email:
